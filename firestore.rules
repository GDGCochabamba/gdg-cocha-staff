rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isGlobalAdmin() {
      return isSignedIn() && userDoc().isGlobalAdmin == true;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isEventLeader(eventId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/events/$(eventId)/applications/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/events/$(eventId)/applications/$(request.auth.uid)).data.role == 'leader';
    }

    function leaderCommission(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)/applications/$(request.auth.uid)).data.commissionId;
    }

    // Public meta: event config, catalog
    match /meta/{doc} {
      allow read: if true;
      allow write: if isGlobalAdmin();
    }

    // Users: identity only
    match /users/{uid} {
      allow read: if isSignedIn();

      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && (
          request.resource.data.isGlobalAdmin == false
          || request.auth.token.email in ['flores1102angel266@gmail.com']
        );

      allow update: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.isGlobalAdmin == resource.data.isGlobalAdmin;

      allow update: if isGlobalAdmin();
      allow delete: if isGlobalAdmin();
    }

    // Events: public read, admin write
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isGlobalAdmin();

      // Applications: one per (event, user)
      match /applications/{uid} {
        allow read: if isSignedIn() && (
          isSelf(uid) ||
          isGlobalAdmin() ||
          isEventLeader(eventId)
        );

        // Create own application: must be self, role 'volunteer', status 'pending'
        allow create: if isSelf(uid)
          && request.resource.data.uid == uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.eventId == eventId
          && request.resource.data.role == 'volunteer'
          && request.resource.data.status == 'pending'
          && request.resource.data.tier == 'none'
          && request.resource.data.acceptedClauseAt != null;

        // Self can cancel or update own clause acceptance
        allow update: if isSelf(uid)
          && request.resource.data.uid == uid
          && request.resource.data.eventId == eventId
          && request.resource.data.role == resource.data.role
          && request.resource.data.tier == resource.data.tier
          && request.resource.data.status in ['pending', 'cancelled']
          && (resource.data.status == 'pending' || resource.data.status == 'approved');

        allow update: if isGlobalAdmin();
        allow delete: if isGlobalAdmin();
      }

      // Shifts: leader of commission or admin writes; volunteer reads own
      match /shifts/{shiftId} {
        allow read: if isSignedIn() && (
          resource.data.volunteerId == request.auth.uid ||
          isGlobalAdmin() ||
          (isEventLeader(eventId) && leaderCommission(eventId) == resource.data.commissionId)
        );

        allow create: if (
          isGlobalAdmin() ||
          (isEventLeader(eventId) && leaderCommission(eventId) == request.resource.data.commissionId)
        )
          && request.resource.data.eventId == eventId
          && request.resource.data.leaderId == request.auth.uid
          && request.resource.data.checkInAt != null;

        allow update: if (
          isGlobalAdmin() ||
          (isEventLeader(eventId) && leaderCommission(eventId) == resource.data.commissionId)
        )
          && request.resource.data.eventId == resource.data.eventId
          && request.resource.data.volunteerId == resource.data.volunteerId
          && request.resource.data.commissionId == resource.data.commissionId;

        allow delete: if isGlobalAdmin();
      }
    }
  }
}
